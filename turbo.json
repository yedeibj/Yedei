{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["ENABLE_EXPERIMENTAL_COREPACK", "FEDAPAY_SECRET_KEY", "FEDAPAY_ENV", "SUPABASE_SERVICE_ROLE_KEY", "RESEND_API_KEY", "NOTIFY_EMAIL_TO"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {}
  }
}
